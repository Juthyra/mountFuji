#!/bin/sh
# Blocks pushes from branches not named main, feature/<action_name> or bug/<action_name>,
# and blocks direct pushes to main (changes must go through a PR).
branch=$(git rev-parse --abbrev-ref HEAD)
case "$branch" in
  main) echo "Direct pushes to main are not allowed. Use a feature/ or bug/ branch + PR."; exit 1 ;;
esac
if ! echo "$branch" | grep -Eq '^(feature|bug)/[a-z0-9]+(-[a-z0-9]+)*$'; then
  echo "Branch '$branch' is invalid. Use feature/<action_name> or bug/<action_name> (lowercase kebab-case)."
  exit 1
fi

# Progress log rule: every branch must change PROGRESS.md relative to origin/main.
if git rev-parse --verify -q origin/main >/dev/null; then
  if ! git diff --name-only origin/main...HEAD | grep -qx 'PROGRESS.md'; then
    echo "PROGRESS.md was not updated on this branch. Add a Changelog entry (see CONTRIBUTING.md) before pushing."
    exit 1
  fi
fi
exit 0
