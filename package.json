{
  "name": "mount-fuji-tests",
  "private": true,
  "description": "Dev-only test tooling. The app itself is the single file index.html with no dependencies.",
  "scripts": {
    "test:sim": "node tests/sim.js",
    "test:probe": "node tests/probe.js",
    "test": "node tests/sim.js && node tests/probe.js && node tests/shots.js",
    "test:shots": "node tests/shots.js",
    "dev": "vite",
    "build": "node scripts/build.js",
    "build:check": "node scripts/build.js --check",
    "lint": "eslint src scripts tests vite.config.js --ext .js"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^6.0.0",
    "puppeteer-core": "19.11.1",
    "vite": "^4.5.5",
    "vite-plugin-singlefile": "^0.13.5"
  },
  "type": "commonjs"
}
